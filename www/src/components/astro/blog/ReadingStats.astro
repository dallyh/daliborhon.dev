---
import { m } from "@paraglide/messages";
import type { Locale } from "@paraglide/runtime";
import type { ReadingStats as ReadingStatsData } from "@utils/content";
import { Icon } from "astro-icon/components";

interface Props {
	stats: ReadingStatsData;
	locale: Locale;
}

const { stats, locale } = Astro.props;
---

<div class="flex flex-wrap gap-x-4 gap-y-2">
	<p class="has-icon icon-left icon-inline">
		<span><Icon name="heroicons:clock" /></span>
		<span>{stats.minutes} {m.common__minutes()}</span>
	</p>
	<p class="has-icon icon-left icon-inline">
		<span><Icon name="heroicons:document-text" /></span>
		<span>{stats.words.toLocaleString(locale)} {m.blog__words()}</span>
	</p>
</div>
