---
import { base } from "astro:config/client";

const pagefindPath = `${base}pagefind/`;
---

<link rel="stylesheet" href={`${pagefindPath}pagefind-component-ui.css`} />
<script type="module" src={`${pagefindPath}pagefind-component-ui.js`}></script>
<pagefind-config bundle-path={pagefindPath} base-url={base}></pagefind-config>
<pagefind-modal>
	<pagefind-modal-header>
		<pagefind-input></pagefind-input>
	</pagefind-modal-header>
	<pagefind-modal-body>
		<pagefind-summary></pagefind-summary>
		<pagefind-filter-pane class="mb-2!" show-empty="true"></pagefind-filter-pane>
		<pagefind-results></pagefind-results>
	</pagefind-modal-body>
	<pagefind-modal-footer>
		<pagefind-keyboard-hints></pagefind-keyboard-hints>
	</pagefind-modal-footer>
</pagefind-modal>

<script>
	interface PagefindInputElement extends HTMLElement {
		inputEl: HTMLInputElement | null;
		clearEl: HTMLButtonElement | null;
	}

	interface PagefindModalElement extends HTMLElement {
		dialogEl: HTMLDialogElement | null;
		isOpen: boolean;
	}

	declare global {
		interface Window {
			__pagefindEscapeHandlerRegistered?: boolean;
		}
	}

	function handlePagefindEscape(event: KeyboardEvent) {
		if (event.key !== "Escape") {
			return;
		}

		const modal = document.querySelector<PagefindModalElement>('pagefind-modal[instance="default"]') ?? document.querySelector<PagefindModalElement>("pagefind-modal");

		if (!modal?.dialogEl?.open) {
			return;
		}

		const pagefindInput = modal.querySelector<PagefindInputElement>("pagefind-input");

		const input = pagefindInput?.inputEl;

		if (!input) {
			return;
		}

		const inputIsFocused = document.activeElement === input;

		const inputHasValue = input.value.length > 0;

		/*
		 * Only override Escape when the search input is focused
		 * and there is actually a query to clear.
		 */
		if (!inputIsFocused || !inputHasValue) {
			return;
		}

		/*
		 * Stop PagefindModal's capture handler from closing
		 * the modal.
		 */
		event.preventDefault();
		event.stopImmediatePropagation();

		/*
		 * Use Pagefind's own clear action so its search state,
		 * button visibility and focus are updated correctly.
		 */
		pagefindInput.clearEl?.click();
	}

	if (!window.__pagefindEscapeHandlerRegistered) {
		window.addEventListener("keydown", handlePagefindEscape, { capture: true });

		window.__pagefindEscapeHandlerRegistered = true;
	}
</script>

<script is:inline>
	(() => {
		const EVENT_NAME = "open-search-modal";
		const INSTANCE_NAME = "default";

		async function openSearchModal() {
			/*
			 * Make sure the Pagefind components have been registered.
			 * This also handles a very fast click shortly after page load.
			 */
			await customElements.whenDefined("pagefind-modal");

			const components = window.PagefindComponents;

			if (!components) {
				console.error("Pagefind Component UI has not loaded.");
				return;
			}

			const instance = components.getInstanceManager().getInstance(INSTANCE_NAME);

			const modal = instance.getUtilities("modal")[0];

			if (!modal || typeof modal.open !== "function") {
				console.error(`No Pagefind modal is registered for instance "${INSTANCE_NAME}".`);
				return;
			}

			modal.open();
		}

		/*
		 * Prevent duplicate listeners during Astro client-side navigation.
		 */
		if (!window.__pagefindModalEventRegistered) {
			window.addEventListener(EVENT_NAME, openSearchModal);

			window.__pagefindModalEventRegistered = true;
		}
	})();
</script>

<style is:global>
	:root[data-theme="light"],
	:root[data-theme="dark"] {
		--pf-text: var(--color-base-content);
		--pf-text-secondary: color-mix(in srgb, var(--color-base-content) 70%, transparent);
		--pf-text-muted: color-mix(in srgb, var(--color-base-content) 55%, transparent);

		--pf-background: var(--color-base-200);
		--pf-skeleton: var(--color-base-200);
		--pf-border: var(--color-base-content);
		--pf-border-focus: var(--color-primary);
		--pf-hover: var(--color-base-100);
		--pf-mark: var(--color-primary);
		--pf-outline-focus: var(--color-primary);
		--pf-font: inherit;

		--pf-border-radius: var(--rounded-btn, 0.5rem);
		--pf-modal-max-width: 48rem;
		--pf-modal-max-height: min(80dvh, 50rem);
		--pf-modal-top: 10dvh;
		--pf-modal-backdrop: rgb(0 0 0 / 0.55);
	}
</style>
