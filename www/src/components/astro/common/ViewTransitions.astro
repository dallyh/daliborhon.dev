---
const settings = {
	color: "var(--color-primary)",
	className: "navigation-loading-bar",
	animationDuration: 900,
};
---

<meta name="loading-bar-data" data-animation-duration={settings.animationDuration} data-classname={settings.className} data-color={settings.color} />

<style is:global>
	.navigation-loading-bar {
		pointer-events: none;
		position: fixed;
		z-index: 1031;
		top: 0;
		left: 0;
		width: 100%;
		height: 2px;
		overflow: hidden;
		opacity: 0;
		transition: opacity 150ms ease-out;

		&::after {
			position: absolute;
			inset: 0 auto 0 0;
			width: 35%;
			background-color: var(--loading-bar-color, var(--color-primary));
			content: "";
			transform: translateX(-110%);
		}

		&.is-active {
			opacity: 1;

			&::after {
				animation: loading-bar-slide var(--loading-bar-duration) ease-in-out infinite;
			}
		}
	}

	@keyframes loading-bar-slide {
		0% {
			transform: translateX(-110%);
		}

		50% {
			width: 45%;
		}

		100% {
			transform: translateX(300%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.navigation-loading-bar::after {
			width: 100%;
			transform: none;
		}

		.navigation-loading-bar.is-active::after {
			animation: none;
		}
	}
</style>

<script>
	declare global {
		interface Window {
			LoadingBar: NavigationLoadingBar;
			ViewTransitions: NavigationLoadingBar;
		}
	}

	class NavigationLoadingBar {
		readonly NAVIGATION_START_EVENT = "navigation-loading:start";

		private isNavigating = false;

		constructor() {
			document.addEventListener("click", this.linkOnclickHandler.bind(this));
			window.addEventListener("pageshow", () => {
				this.isNavigating = false;
			});
		}

		startTransition() {
			if (this.isNavigating) return;

			this.isNavigating = true;
			window.dispatchEvent(new CustomEvent(this.NAVIGATION_START_EVENT));
		}

		private shouldShowForLink(link: HTMLAnchorElement, event: MouseEvent) {
			if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
				return false;
			}

			if (!link.hasAttribute("href") || link.hasAttribute("data-disable-transition")) {
				return false;
			}

			if (link.hasAttribute("download") || (link.target && link.target !== "_self")) {
				return false;
			}

			if (link.origin !== window.location.origin) {
				return false;
			}

			if (link.pathname === window.location.pathname && link.search === window.location.search && link.hash) {
				return false;
			}

			return true;
		}

		private linkOnclickHandler(event: MouseEvent) {
			const target = event.target;
			if (!(target instanceof Element)) return;

			const link = target.closest("a");
			if (!(link instanceof HTMLAnchorElement) || !this.shouldShowForLink(link, event)) return;

			this.startTransition();
		}
	}

	window.LoadingBar = new NavigationLoadingBar();

	// Preserve compatibility with components that already call
	// window.ViewTransitions.startTransition() before programmatic navigation.
	window.ViewTransitions = window.LoadingBar;
</script>

<script is:inline>
	//@ts-check
	function initLoadingBar() {
		const ACTIVE_CLASS = "is-active";

		/** @type {HTMLMetaElement | null} */
		const meta = document.head.querySelector("meta[name='loading-bar-data']");
		const className = meta?.dataset.classname ?? "navigation-loading-bar";
		const animationDuration = Number(meta?.dataset.animationDuration ?? 900);
		const color = meta?.dataset.color ?? "var(--color-primary)";
		const element = document.createElement("div");

		element.classList.add(className);
		element.ariaHidden = "true";
		element.style.setProperty("--loading-bar-duration", `${animationDuration}ms`);
		element.style.setProperty("--loading-bar-color", color);

		document.addEventListener("DOMContentLoaded", () => {
			document.body.prepend(element);
		});

		window.addEventListener("navigation-loading:start", () => {
			element.classList.add(ACTIVE_CLASS);
		});

		/** @param {PageRevealEvent} event */
		function pageRevealCallback(event) {
			if (!event.viewTransition) return;

			document.body.prepend(element);
			element.classList.add(ACTIVE_CLASS);

			document.addEventListener("DOMContentLoaded", () => {
				window.setTimeout(() => {
					element.classList.remove(ACTIVE_CLASS);
				}, 50);
			});
		}

		window.addEventListener("pagereveal", pageRevealCallback);
	}

	initLoadingBar();
</script>

<style is:inline>
	@media (prefers-reduced-motion: no-preference) {
		@view-transition {
			navigation: auto;
		}

		:root::view-transition-old(*),
		:root::view-transition-new(*) {
			animation-duration: 400ms;
		}
	}
</style>
