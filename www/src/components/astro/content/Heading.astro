---
import type { Locale } from "@paraglide/runtime";
import { slugifyStr } from "@utils";

interface Props {
	id?: string;
	level: 1 | 2 | 3 | 4 | 5 | 6;
}

const { id, level } = Astro.props;
const locale = Astro.currentLocale as Locale;

const HeadingTag = `h${level}` as keyof HTMLElementTagNameMap;
const sluggedId = slugifyStr(undefined, id ?? "");
---

<HeadingTag id={sluggedId} class="flex items-center gap-x-2">
	<slot />
	<a href={`#${sluggedId}`} aria-hidden="true" tabindex="-1">
		<span class="heading-link-icon"></span>
	</a>
</HeadingTag>

<style>
	:is(h1, h2, h3, h4, h5, h6) {
		display: block;
		position: relative;

		a {
			display: inline;
			text-decoration: none;

			.heading-link-icon {
				display: inline;
				margin-left: 0.4rem;
				color: var(--color-primary);

				&::after {
					content: "#";
				}
			}
		}
	}

	/* Hide by default only on devices with real hover support */
	@media (hover: hover) and (pointer: fine) {
		:is(h1, h2, h3, h4, h5, h6) {
			.heading-link-icon {
				opacity: 0;
				visibility: hidden;
				transition:
					opacity 200ms ease,
					color 200ms ease;
			}

			&:hover .heading-link-icon,
			&:focus-within .heading-link-icon {
				opacity: 1;
				visibility: visible;
			}
		}
	}
</style>
